{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Java",
            "type": "java",
            "request": "launch",
            "stopOnEntry": true,
            "jdkPath": "${env:JAVA_HOME}/bin",
            "cwd": "${fileDirname}",
            "startupClass": "${fileBasenameNoExtension}",
            "classpath": [
                ".",
                "${fileDirname}"
            ]
        },
        {
            "name": "Java Console App",
            "type": "java",
            "request": "launch",
            "stopOnEntry": true,
            "jdkPath": "${env:JAVA_HOME}/bin",
            "cwd": "${fileDirname}",
            "startupClass": "${fileBasenameNoExtension}",
            "classpath": [
                ".",
                "${fileDirname}"
            ],
            "externalConsole": true
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "App",
            "request": "launch",
            "mainClass": "manager.server.App",
            "projectName": "app"
        },
        {
            "type": "java",
            "name": "TestClient",
            "request": "launch",
            "mainClass": "manager.server.TestClient",
            "projectName": "app"
        },
        {
            "type": "java",
            "name": "DockerDemo",
            "request": "launch",
            "mainClass": "com.example.docker.DockerDemo",
            "projectName": "docker-java-demo-docker-java-busybox"
        },
        {
            "type": "java",
            "name": "ContainerRunner",
            "request": "launch",
            "mainClass": "com.example.docker.ContainerRunner",
            "projectName": "docker-java-runner"
        },
        {
            "type": "java",
            "name": "RedisKeyValueExample",
            "request": "launch",
            "mainClass": "com.example.redis.RedisKeyValueExample",
            "projectName": "redis-kv-example-1-redis-kv-example"
        }
    ]
}